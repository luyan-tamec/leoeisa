# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────
# Local (Docker):   postgresql://postgres:postgres@cinevote.onrender.com/cinevote
# Render:           provided automatically in DATABASE_URL env var
# Neon/Supabase:    copy from dashboard
DATABASE_URL=postgresql://postgres:postgres@cinevote.onrender.com/cinevote

# ─── Session ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

SESSION_SECRET=9f8c7d6a2b1e4f5a8c3d9e7f1a6b2c4d5e8f7a1c3b9d6e2f4a8c1b7d5e9f3a6

# ─── Twitch OAuth ───────────────────────────────────────────────────────
# 1. Go to https://dev.twitch.tv/console/apps
# 2. Register a new app (category: Website Integration)
# 3. Set redirect URI to http://localhost:3000/auth/twitch/callback (dev)
#    and https://yourdomain.com/auth/twitch/callback (prod)
TWITCH_CLIENT_ID=x4qevszaoxnscv462g6913dzo3m71t
TWITCH_CLIENT_SECRET=vojk7013gyuht5w0lsi73gjozyeaxt
TWITCH_REDIRECT_URI=https://cinevote.onrender.com/auth/twitch/callback

# ─── CORS ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://cinevote.onrender.com

# ─── Admin ──────────────────────────────────────────────────────────────
# After first deploy, manually set isAdmin=true for your Twitch user in DB:
# UPDATE users SET "isAdmin"=true WHERE "twitchId"='YOUR_TWITCH_ID';
